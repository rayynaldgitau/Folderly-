{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foldy",
  "version": "0.1.3",
  "identifier": "com.foldy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foldy",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NTBBNzA5RDJDMkMxNDQKUldSRXdjTFNDYWRRZVBoUldNNUN1OHdkd2I1OEVsdlJvUktwdFExTHczU0NjdCt3VXAxb20yWUYK",
      "endpoints": [
        "https://github.com/rayynaldgitau/Folderly-/releases/latest/download/latest.json"
      ]
    }
  }
}
